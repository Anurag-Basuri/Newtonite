# Database
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=opsboard
MONGO_MAX_POOL=20
MONGO_MIN_POOL=5

# Security & Sessions
SESSION_SECRET=dev-secret-key-opsboard-super-secure-change-in-prod-32chars
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000

# Worker & Outbox
WORKER_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_LEASE_SECONDS=30

# AI Configuration (Optional: runs offline with fake provider if key absent)
AI_ENABLED=true
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Provider Options: 'fake', 'openai', 'anthropic', or 'none'
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=claude-3-5-sonnet-20241022
AI_RATE_LIMIT_PER_MIN=10

# --- Free Tier Provider Presets (Uncomment one to use) ---
# 1. Groq (Recommended - 100% Free & Ultra-Fast, https://console.groq.com/keys):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your_groq_api_key
# LLM_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Google AI Studio, https://aistudio.google.com/apikey):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIzaSy_your_gemini_key
# LLM_MODEL=gemini-1.5-flash

# 3. OpenRouter Free Tier (https://openrouter.ai/keys):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Observability
LOG_LEVEL=INFO
ENVIRONMENT=development
